# Archivo de ejemplo para desarrollo local.
# Copia este archivo como .env dentro de snoopy-project-2-backend y cambia los valores necesarios.

# Puerto local del backend Express
PORT=4000

# Entorno local
NODE_ENV=development

# Base de datos local de Snoopy Project 2
DATABASE_URL=postgresql://postgres:TU_PASSWORD_POSTGRES@localhost:5432/snoopy_project_2

# Clave secreta local para firmar JWT; cámbiala por una cadena larga
JWT_SECRET=cambia_esta_clave_por_una_muy_segura

# URL del frontend local permitida por CORS
FRONTEND_URL=http://localhost:5173

# En PostgreSQL local debe quedarse en false
DB_SSL=false

# Usuario inicial del sistema
ADMIN_USERNAME=Snoopy
ADMIN_PASSWORD=2001
ADMIN_ROLE=admin

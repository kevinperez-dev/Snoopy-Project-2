{
  "name": "snoopy-project-2-backend",
  "version": "1.0.0",
  "description": "Backend para Snoopy Project 2 con Node.js, Express y PostgreSQL",
  "main": "src/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed:admin": "node src/database/seedAdmin.js",
    "create:user": "node src/database/createUser.js",
    "db:init": "node src/database/initDatabase.js",
    "db:setup": "npm run db:init && npm run seed:admin",
    "render:build": "npm install && npm run db:setup"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
